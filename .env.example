# DashScope 必填配置
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# DashScope 接口地址，通常无需修改
DASHSCOPE_UPLOADS_URL=https://dashscope.aliyuncs.com/api/v1/uploads
DASHSCOPE_VIDEO_SYNTHESIS_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/image2video/video-synthesis
DASHSCOPE_TASKS_URL=https://dashscope.aliyuncs.com/api/v1/tasks

# 请求和轮询配置
DASHSCOPE_REQUEST_TIMEOUT_SECONDS=1800
DASHSCOPE_POLL_INTERVAL_SECONDS=15
DASHSCOPE_VERIFY_SSL=false

# 视频生成参数
DASHSCOPE_WATERMARK=false
DASHSCOPE_CHECK_IMAGE=true
DASHSCOPE_GENERATION_MODE=wan-pro
