}
QLabel#titleLabel {
    color: #111827;
    font-size: 26px;
    font-weight: 700;
}
QLabel#subtitleLabel {
    color: #5b6472;
    font-size: 14px;
}
QGroupBox {
    background: #ffffff;
    border: 1px solid #d9dee7;
    border-radius: 8px;
    margin-top: 18px;
    padding: 18px 16px 14px 16px;
    font-size: 15px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 8px;
    color: #111827;
}
QLineEdit {
    background: #ffffff;
    border: 1px solid #cbd3df;
    border-radius: 6px;
    padding: 8px 10px;
    selection-background-color: #2f6feb;
}
QLineEdit:focus {
    border-color: #2f6feb;
}
QLineEdit[readOnly="true"] {
    background: #f9fafb;
    color: #374151;
}
QPushButton {
    background: #ffffff;
    border: 1px solid #cbd3df;
    border-radius: 6px;
    padding: 8px 14px;
    min-height: 20px;
}
QPushButton:hover {
    background: #f3f6fb;
}
QPushButton:pressed {
    background: #e8edf6;
}
QPushButton:disabled {
    color: #9aa3af;
    background: #f3f4f6;
}
QPushButton#generateButton {
    background: #1f6feb;
    border-color: #1f6feb;
    color: #ffffff;
    font-weight: 600;
}
QPushButton#generateButton:hover {
    background: #1a5fd0;
}
QTextEdit {
    background: #111827;
    color: #d1d5db;
    border: 1px solid #111827;
    border-radius: 8px;
    padding: 10px;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 12px;
}
QProgressBar {
    border: 1px solid #d9dee7;
    border-radius: 5px;
    text-align: center;
    background: #ffffff;
    min-height: 10px;
}
QProgressBar::chunk {
    background: #1f6feb;
    border-radius: 4px;
}</string>
